<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Robux Demo</title>

<style>

* {
    box-sizing: border-box;
}

html,
body {
    margin: 0;
    padding: 0;
    background: #0f1012;
    color: #f2f2f3;
    font-family: Arial, Helvetica, sans-serif;
}

body {
    min-height: 100vh;
}

.demo-label {
    position: fixed;
    right: 14px;
    bottom: 14px;
    z-index: 9999;
    background: #292b31;
    color: #c8c9cc;
    border: 1px solid #44464d;
    border-radius: 7px;
    padding: 7px 10px;
    font-size: 11px;
    font-weight: bold;
    letter-spacing: .3px;
}

.top-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 52px;
    background: #191a1f;
    border-bottom: 1px solid #303238;
    display: flex;
    align-items: center;
    z-index: 1000;
}

.left-header {
    height: 52px;
    display: flex;
    align-items: center;
}

.menu {
    width: 48px;
    height: 52px;
    display: flex;
    justify-content: center;
    align-items: center;
}

.menu span {
    display: block;
    width: 21px;
    height: 2px;
    background: #ddd;
    margin: 4px 0;
    border-radius: 2px;
}

.roblox-logo {
    width: 31px;
    height: 31px;
    background: white;
    transform: rotate(14deg);
    position: relative;
    margin-left: 1px;
}

.roblox-logo::after {
    content: "";
    position: absolute;
    width: 8px;
    height: 8px;
    background: #191a1f;
    left: 8px;
    top: 8px;
}

.header-right {
    margin-left: auto;
    height: 52px;
    display: flex;
    align-items: center;
    gap: 17px;
    padding-right: 14px;
}

.profile {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #292b31;
    border: 1px solid #3b3d44;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    font-weight: bold;
}

.search {
    width: 21px;
    height: 21px;
    border: 2px solid #dedfe2;
    border-radius: 50%;
    position: relative;
}

.search::after {
    content: "";
    position: absolute;
    width: 8px;
    height: 2px;
    background: #dedfe2;
    right: -6px;
    bottom: -3px;
    transform: rotate(48deg);
}

.hex {
    width: 22px;
    height: 22px;
    border: 2px solid #dedfe2;
    transform: rotate(45deg);
    border-radius: 6px;
    position: relative;
}

.hex::after {
    content: "";
    position: absolute;
    width: 6px;
    height: 6px;
    border: 2px solid #dedfe2;
    left: 5px;
    top: 5px;
    border-radius: 2px;
}

.settings {
    font-size: 22px;
    color: #ddd;
}

.navbar {
    position: fixed;
    top: 52px;
    left: 0;
    width: 100%;
    height: 40px;
    background: #191a1f;
    border-bottom: 1px solid #303238;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    z-index: 999;
}

.nav {
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 18px;
    font-weight: 700;
    cursor: pointer;
}

.nav:hover {
    background: #24262b;
}

.page {
    padding-top: 92px;
    min-height: 100vh;
}

.container {
    width: 720px;
    max-width: calc(100% - 24px);
    margin: auto;
    padding-top: 22px;
    padding-bottom: 80px;
}

.balance {
    height: 72px;
    background: #1b1c20;
    border: 1px solid #303238;
    border-radius: 14px;
    display: flex;
    align-items: center;
    padding: 0 18px;
    margin-bottom: 20px;
}

.robux-icon {
    width: 24px;
    height: 24px;
    position: relative;
    flex-shrink: 0;
}

.robux-icon svg {
    width: 100%;
    height: 100%;
    display: block;
}

.balance-number {
    font-size: 36px;
    font-weight: 700;
    margin-left: 10px;
}

.send-top {
    margin-left: auto;
    height: 42px;
    padding: 0 17px;
    border: 0;
    border-radius: 9px;
    background: #292c34;
    color: white;
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
}

.send-top:hover {
    background: #3a3e48;
}

.hero {
    height: 245px;
    border-radius: 14px;
    background:
        radial-gradient(
            circle at 50% 40%,
            #191b20 0%,
            #111215 65%,
            #0f1012 100%
        );
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    position: relative;
    overflow: hidden;
    margin-bottom: 38px;
}

.hero::before {
    content: "";
    position: absolute;
    inset: 0;
    opacity: .18;
    background-image:
        linear-gradient(
            rgba(255,255,255,.08) 1px,
            transparent 1px
        ),
        linear-gradient(
            90deg,
            rgba(255,255,255,.08) 1px,
            transparent 1px
        );
    background-size: 31px 31px;
    transform: perspective(300px) rotateX(55deg) scale(1.5);
    transform-origin: center;
}

.hero-title {
    position: relative;
    z-index: 1;
    font-size: 53px;
    line-height: 1.12;
    font-weight: 700;
    max-width: 620px;
}
.limited-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
}

.limited-title {
    font-size: 18px;
    font-weight: 700;
}

.timer {
    background: #f0f0f1;
    color: #222;
    padding: 7px 12px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 700;
}

.feature {
    background: #25272c;
    border-radius: 15px;
    overflow: hidden;
    border: 1px solid #303238;
    margin-bottom: 32px;
}

.feature-image {
    height: 285px;
    display: flex;
    justify-content: center;
    align-items: center;
    background: #25272c;
}

.crown {
    font-size: 95px;
}

.feature-info {
    padding: 20px 22px;
    background: #24262b;
}

.feature-name {
    font-size: 18px;
    font-weight: 700;
    margin-bottom: 8px;
}

.creator {
    color: #c3c5ca;
    font-size: 14px;
}

.verified {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    width: 16px;
    height: 16px;
    margin-left: 3px;
    background: #1683e6;
    border-radius: 3px;
    color: white;
    font-size: 10px;
}

.feature-bottom {
    min-height: 64px;
    background: #3a3d46;
    display: flex;
    align-items: center;
    padding: 10px 18px;
}

.feature-amount {
    display: flex;
    align-items: center;
    gap: 8px;
}

.feature-current {
    font-size: 24px;
    font-weight: 700;
}

.feature-old {
    color: #92959d;
    text-decoration: line-through;
    font-size: 16px;
}

.price-button {
    margin-left: auto;
    min-width: 138px;
    height: 42px;
    border: 0;
    border-radius: 9px;
    background: #505463;
    color: white;
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
}

.section-title {
    font-size: 18px;
    font-weight: 700;
    margin-bottom: 8px;
}

.terms {
    color: #989ba3;
    font-size: 13px;
    line-height: 1.5;
    margin-bottom: 16px;
}

.packages {
    border: 1px solid #35373d;
    border-radius: 15px;
    overflow: hidden;
    background: #141518;
}

.package {
    min-height: 64px;
    display: flex;
    align-items: center;
    padding: 9px 18px;
    border-bottom: 1px solid #292b30;
}

.package:last-child {
    border-bottom: 0;
}

.package:hover {
    background: #1c1e22;
}

.package-left {
    display: flex;
    align-items: center;
    gap: 9px;
}

.package-current {
    font-size: 22px;
    font-weight: 700;
}

.package-old {
    color: #858890;
    text-decoration: line-through;
    font-size: 15px;
}

.package-button {
    margin-left: auto;
    width: 105px;
    height: 40px;
    border: 0;
    border-radius: 9px;
    background: #292c34;
    color: white;
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
}

.package-button:hover {
    background: #3a3e48;
}

.send-panel {
    margin-top: 35px;
    padding: 22px;
    background: #1c1e23;
    border: 1px solid #34373e;
    border-radius: 15px;
}

.send-title {
    font-size: 20px;
    font-weight: 700;
    margin-bottom: 6px;
}

.send-description {
    color: #9699a1;
    font-size: 13px;
    line-height: 1.5;
    margin-bottom: 20px;
}

.label {
    display: block;
    color: #c9cbd0;
    font-size: 13px;
    margin-bottom: 7px;
}

.input {
    width: 100%;
    height: 44px;
    background: #111216;
    color: white;
    border: 1px solid #3a3d45;
    border-radius: 8px;
    padding: 0 13px;
    outline: none;
    font-size: 14px;
    margin-bottom: 13px;
}

.input:focus {
    border-color: #737783;
}

.find-button {
    width: 100%;
    height: 43px;
    border: 0;
    border-radius: 8px;
    background: #30333b;
    color: white;
    font-weight: 700;
    cursor: pointer;
    margin-bottom: 14px;
}

.find-button:hover {
    background: #424650;
}

.user-result {
    display: none;
    align-items: center;
    gap: 12px;
    background: #111216;
    border: 1px solid #34373e;
    border-radius: 9px;
    padding: 12px;
    margin-bottom: 14px;
}

.avatar {
    width: 58px;
    height: 58px;
    border-radius: 9px;
    object-fit: cover;
}

.username {
    font-size: 16px;
    font-weight: 700;
}

.userid {
    color: #858891;
    font-size: 12px;
    margin-top: 4px;
}

.send-button {
    width: 100%;
    height: 44px;
    border: 0;
    border-radius: 8px;
    background: #3b3e48;
    color: white;
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
}

.send-button:hover {
    background: #4b4f5b;
}

.message {
    margin-top: 13px;
    color: #b7bac1;
    font-size: 13px;
    line-height: 1.5;
}

.history {
    display: none;
    margin-top: 22px;
    background: #15171b;
    border: 1px solid #33363d;
    border-radius: 12px;
    overflow: hidden;
}

.history-title {
    padding: 15px;
    font-weight: 700;
    border-bottom: 1px solid #303238;
}

.history-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 13px 15px;
    border-bottom: 1px solid #282a30;
}

.history-item:last-child {
    border-bottom: 0;
}

.history-user {
    font-weight: 700;
    font-size: 14px;
}

.history-amount {
    color: #b8bac0;
    font-size: 13px;
}

@media(max-width:700px) {

    .header-right {
        gap: 10px;
    }

    .hex {
        display: none;
    }

    .nav {
        font-size: 13px;
    }

    .container {
        max-width: calc(100% - 18px);
        padding-top: 14px;
    }

    .balance-number {
        font-size: 28px;
    }

    .hero {
        height: 190px;
    }

    .hero-title {
        font-size: 37px;
    }

    .feature-image {
        height: 220px;
    }

    .feature-bottom {
        flex-wrap: wrap;
        gap: 10px;
    }

    .price-button {
        width: 100%;
        margin-left: 0;
    }

    .package-current {
        font-size: 18px;
    }

    .package-old {
        font-size: 13px;
    }

    .package-button {
        width: 85px;
    }

}

</style>
</head>

<body>

<div class="demo-label">
    DEMO • NO REAL ROBUX
</div>


<header class="top-header">

    <div class="left-header">

        <div class="menu">

            <div>
                <span></span>
                <span></span>
                <span></span>
            </div>

        </div>

        <div class="roblox-logo"></div>

    </div>


    <div class="header-right">

        <div class="profile">
            A
        </div>

        <div class="search"></div>

        <div class="hex"></div>

        <div class="settings">
            ⚙
        </div>

    </div>

</header>


<nav class="navbar">

    <div class="nav">
        Charts
    </div>

    <div class="nav">
        Marketplace
    </div>

    <div class="nav">
        Create
    </div>

    <div class="nav">
        Robux
    </div>

</nav>


<main class="page">

<div class="container">


    <div class="balance">

        <div class="robux-icon">

            <svg viewBox="0 0 32 32">

                <path
                    d="M8 3L28 8L24 29L4 24L8 3Z"
                    fill="none"
                    stroke="#e1e3e6"
                    stroke-width="2.4"
                />

                <path
                    d="M13 10L21 12L19 21L11 19L13 10Z"
                    fill="none"
                    stroke="#e1e3e6"
                    stroke-width="2.2"
                />

            </svg>

        </div>

        <div class="balance-number">
            10,000
        </div>

        <button
            class="send-top"
            onclick="scrollToSend()"
        >
            ↑ Send
        </button>

    </div>


    <section class="hero">

        <div class="hero-title">

            Enjoy up to 25%<br>
            more Robux

        </div>

    </section>


    <div class="limited-header">

        <div class="limited-title">
            Limited-time avatar items
        </div>

        <div class="timer">
            12 days left
        </div>

    </div>


    <div class="feature">

        <div class="feature-image">

            <div class="crown">
                👑
            </div>

        </div>


        <div class="feature-info">

            <div class="feature-name">
                Gold Crown of Ozymandias
            </div>

            <div class="creator">

                Roblox

                <span class="verified">
                    ✓
                </span>

            </div>

        </div>


        <div class="feature-bottom">

            <div class="feature-amount">

                <div class="robux-icon">

                    <svg viewBox="0 0 32 32">

                        <path
                            d="M8 3L28 8L24 29L4 24L8 3Z"
                            fill="none"
                            stroke="#e1e3e6"
                            stroke-width="2.4"
                        />

                        <path
                            d="M13 10L21 12L19 21L11 19L13 10Z"
                            fill="none"
                            stroke="#e1e3e6"
                            stroke-width="2.2"
                        />

                    </svg>

                </div>

                <div class="feature-current">
                    24,000
                </div>

                <div class="feature-old">
                    22,500
                </div>

            </div>


            <button
                class="price-button"
                onclick="demoPurchase(24000)"
            >
                $238.00
            </button>

        </div>

    </div>


    <div class="section-title">
        Robux packages
    </div>

    <div class="terms">

        By purchasing Robux, you agree to our
        Terms of Use, including the arbitration clause
        and revocation policy.

    </div>


    <div class="packages">


        <div class="package">

            <div class="package-left">

                <div class="robux-icon">

                    <svg viewBox="0 0 32 32">

                        <path
                            d="M8 3L28 8L24 29L4 24L8 3Z"
                            fill="none"
                            stroke="#e1e3e6"
                            stroke-width="2.4"
                        />

                        <path
                            d="M13 10L21 12L19 21L11 19L13 10Z"
                            fill="none"
                            stroke="#e1e3e6"
                            stroke-width="2.2"
                        />

                    </svg>

                </div>

                <div class="package-current">
                    11,000
                </div>

                <div class="package-old">
                    10,000
                </div>

            </div>

            <button
                class="package-button"
                onclick="demoPurchase(11000)"
            >
                $119.00
            </button>

        </div>


        <div class="package">

            <div class="package-left">

                <div class="robux-icon">

                    <svg viewBox="0 0 32 32">

                        <path
                            d="M8 3L28 8L24 29L4 24L8 3Z"
                            fill="none"
                            stroke="#e1e3e6"
                            stroke-width="2.4"
                        />

                        <path
                            d="M13 10L21 12L19 21L11 19L13 10Z"
                            fill="none"
                            stroke="#e1e3e6"
                            stroke-width="2.2"
                        />

                    </svg>

                </div>

                <div class="package-current">
                    5,250
                </div>

                <div class="package-old">
                    4,500
                </div>

            </div>

            <button
                class="package-button"
                onclick="demoPurchase(5250)"
            >
                $59.50
            </button>

        </div>


        <div class="package">

            <div class="package-left">

                <div class="robux-icon">

                    <svg viewBox="0 0 32 32">

                        <path
                            d="M8 3L28 8L24 29L4 24L8 3Z"
                            fill="none"
                            stroke="#e1e3e6"
                            stroke-width="2.4"
                        />

                        <path
                            d="M13 10L21 12L19 21L11 19L13 10Z"
                            fill="none"
                            stroke="#e1e3e6"
                            stroke-width="2.2"
                        />

                    </svg>

                </div>

                <div class="package-current">
                    3,625
                </div>

                <div class="package-old">
                    3,150
                </div>

            </div>

            <button
                class="package-button"
                onclick="demoPurchase(3625)"
            >
                $34.83
            </button>

        </div>


        <div class="package">

            <div class="package-left">

                <div class="robux-icon">

                    <svg viewBox="0 0 32 32">

                        <path
                            d="M8 3L28 8L24 29L4 24L8 3Z"
                            fill="none"
                            stroke="#e1e3e6"
                            stroke-width="2.4"
                        />

                        <path
                            d="M13 10L21 12L19 21L11 19L13 10Z"
                            fill="none"
                            stroke="#e1e3e6"
                            stroke-width="2.2"
                        />

                    </svg>

                </div>

                <div class="package-current">
                    2,000
                </div>

                <div class="package-old">
                    1,700
                </div>

            </div>

            <button
                class="package-button"
                onclick="demoPurchase(2000)"
            >
                $23.80
            </button>

        </div>


        <div class="package">

            <div class="package-left">

                <div class="robux-icon">

                    <svg viewBox="0 0 32 32">

                        <path
                            d="M8 3L28 8L24 29L4 24L8 3Z"
                            fill="none"
                            stroke="#e1e3e6"
                            stroke-width="2.4"
                        />

                        <path
                            d="M13 10L21 12L19 21L11 19L13 10Z"
                            fill="none"
                            stroke="#e1e3e6"
                            stroke-width="2.2"
                        />

                    </svg>

                </div>

                <div class="package-current">
                    1,500
                </div>

                <div class="package-old">
                    1,200
                </div>

            </div>

            <button
                class="package-button"
                onclick="demoPurchase(1500)"
            >
                $13.98
            </button>

        </div>


        <div class="package">

            <div class="package-left">

                <div class="robux-icon">

                    <svg viewBox="0 0 32 32">

                        <path
                            d="M8 3L28 8L24 29L4 24L8 3Z"
                            fill="none"
                            stroke="#e1e3e6"
                            stroke-width="2.4"
                        />

                        <path
                            d="M13 10L21 12L19 21L11 19L13 10Z"
                            fill="none"
                            stroke="#e1e3e6"
                            stroke-width="2.2"
                        />

                    </svg>

                </div>

                <div class="package-current">
                    800
                </div>

                <div class="package-old">
                    700
                </div>

            </div>

            <button
                class="package-button"
                onclick="demoPurchase(800)"
            >
                $7.99
            </button>

        </div>


        <div class="package">

            <div class="package-left">

                <div class="robux-icon">

                    <svg viewBox="0 0 32 32">

                        <path
                            d="M8 3L28 8L24 29L4 24L8 3Z"
                            fill="none"
                            stroke="#e1e3e6"
                            stroke-width="2.4"
                        />

                        <path
                            d="M13 10L21 12L19 21L11 19L13 10Z"
                            fill="none"
                            stroke="#e1e3e6"
                            stroke-width="2.2"
                        />

                    </svg>

                </div>

                <div class="package-current">
                    400
                </div>

                <div class="package-old">
                    350
                </div>

            </div>

            <button
                class="package-button"
                onclick="demoPurchase(400)"
            >
                $4.99
            </button>

        </div>


    </div>
<section
        class="send-panel"
        id="sendPanel"
    >

        <div class="send-title">
            Send Robux
        </div>

        <div class="send-description">
            Demo simulation only.
            No real Robux will be transferred.
        </div>


        <label class="label">
            Roblox username
        </label>

        <input
            id="username"
            class="input"
            type="text"
            placeholder="Enter Roblox username"
        >


        <button
            class="find-button"
            onclick="findUser()"
        >
            Find Roblox User
        </button>


        <div
            class="user-result"
            id="userResult"
        >

            <img
                id="avatar"
                class="avatar"
                src=""
                alt="Roblox Avatar"
            >

            <div>

                <div
                    id="displayName"
                    class="username"
                ></div>

                <div
                    id="userId"
                    class="userid"
                ></div>

            </div>

        </div>


        <label class="label">
            Robux amount
        </label>

        <input
            id="amount"
            class="input"
            type="number"
            min="1"
            placeholder="Example: 100"
        >


        <button
            class="send-button"
            onclick="sendRobuxDemo()"
        >
            Send Robux
        </button>


        <div
            id="message"
            class="message"
        ></div>


        <div
            class="history"
            id="history"
        >

            <div class="history-title">
                Demo transfer history
            </div>

            <div id="historyList"></div>

        </div>

    </section>


</div>

</main>


<script>

let selectedUser = null;


/* =========================
   SCROLL TO SEND
========================= */

function scrollToSend() {

    document
        .getElementById("sendPanel")
        .scrollIntoView({
            behavior: "smooth"
        });

}


/* =========================
   FIND ROBLOX USER
========================= */

async function findUser() {

    const username =
        document
        .getElementById("username")
        .value
        .trim();

    const message =
        document
        .getElementById("message");

    const result =
        document
        .getElementById("userResult");


    if (!username) {

        message.textContent =
            "Please enter a Roblox username.";

        return;

    }


    message.textContent =
        "Searching Roblox public profile...";

    result.style.display =
        "none";


    try {

        const response =
            await fetch(
                "https://users.roblox.com/v1/usernames/users",
                {

                    method: "POST",

                    headers: {
                        "Content-Type":
                            "application/json"
                    },

                    body: JSON.stringify({

                        usernames: [
                            username
                        ],

                        excludeBannedUsers:
                            false

                    })

                }
            );


        if (!response.ok) {

            throw new Error(
                "Roblox request failed"
            );

        }


        const data =
            await response.json();


        if (
            !data.data ||
            data.data.length === 0
        ) {

            selectedUser = null;

            message.textContent =
                "Roblox user not found.";

            return;

        }


        selectedUser =
            data.data[0];


        /* GET PUBLIC AVATAR */

        const avatarResponse =
            await fetch(

                "https://thumbnails.roblox.com/v1/users/avatar-headshot?userIds="
                + selectedUser.id
                + "&size=150x150&format=Png&isCircular=false"

            );


        const avatarData =
            await avatarResponse.json();


        if (
            avatarData.data &&
            avatarData.data.length > 0
        ) {

            document
                .getElementById("avatar")
                .src =
                avatarData.data[0]
                    .imageUrl;

        }


        document
            .getElementById("displayName")
            .textContent =
            selectedUser.displayName;


        document
            .getElementById("userId")
            .textContent =
            "@"
            + selectedUser.name
            + " • ID "
            + selectedUser.id;


        result.style.display =
            "flex";


        message.textContent =
            "Public Roblox profile found.";

    }

    catch(error) {

        selectedUser = null;

        message.textContent =
            "Unable to connect to Roblox public data.";

    }

}


/* =========================
   SEND DEMO
========================= */

function sendRobuxDemo() {

    const amount =
        Number(
            document
            .getElementById("amount")
            .value
        );


    const message =
        document
        .getElementById("message");


    if (!selectedUser) {

        message.textContent =
            "Find a Roblox user first.";

        return;

    }


    if (
        !amount ||
        amount <= 0
    ) {

        message.textContent =
            "Enter a valid Robux amount.";

        return;

    }


    if (amount > 1000000) {

        message.textContent =
            "Demo amount is too large.";

        return;

    }


    message.textContent =
        "Preparing demo transfer...";


    setTimeout(function() {

        message.textContent =
            "Demo transfer complete to @"
            + selectedUser.name
            + ". No real Robux was transferred.";


        addHistory(
            selectedUser.name,
            amount
        );


    }, 1200);

}


/* =========================
   DEMO HISTORY
========================= */

function addHistory(
    username,
    amount
) {

    const history =
        document
        .getElementById("history");


    const list =
        document
        .getElementById("historyList");


    const item =
        document.createElement("div");


    item.className =
        "history-item";


    item.innerHTML =

        "<div class='history-user'>"
        + "@"
        + username
        + "</div>"

        +

        "<div class='history-amount'>"
        + amount.toLocaleString()
        + " Robux • Demo"
        + "</div>";


    list.prepend(item);


    history.style.display =
        "block";

}


/* =========================
   PACKAGE BUTTON
========================= */

function demoPurchase(
    amount
) {

    alert(

        "DEMO ONLY\n\n"
        + amount.toLocaleString()
        + " Robux package selected.\n\n"
        + "No purchase was made.\n"
        + "No real Robux was added."

    );

}

</script>

</body>
</html>
